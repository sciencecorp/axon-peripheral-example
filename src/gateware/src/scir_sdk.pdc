# >>> AXON PERIPHERAL SDK FRAMEWORK CONSTRAINTS (generated; do not edit) >>>
# SDK Via Devkit physical constraints — minimal.
#
# Only the pins needed by the auto-generated `via_top.sv`:
#   - ext_xo_i: 48 MHz reference clock
#   - ir_txa_o / ir_txb_o: IR transmitter LVDS pair
#   - nrf_sclk_i / nrf_csn_i / nrf_mosi_i / nrf_miso_o / nrf_irq_o: BLE bridge SPI
#   - en_ldo_o: regulator enable
#
# Production-only neural-recording and on-chip peripheral pins from the
# production devkit are intentionally NOT included — the SDK target leaves those
# FPGA pads free so the user can claim them in the user-append region below.
#
# This is the FRAMEWORK region of <project>/src/scir_sdk.pdc: `axon-peripheral-sdk
# generate` re-emits it on every run. Do not edit here — add your own pin
# constraints in the user-append region below the framework end marker, which
# `generate` preserves verbatim.

ldc_set_sysconfig {CONFIGIO_VOLTAGE_BANK0=1.8 CONFIGIO_VOLTAGE_BANK1=1.8 DONE_PORT=DISABLE INITN_PORT=DISABLE PROGRAMN_PORT=DISABLE}
ldc_set_vcc -bank 0 1.8
ldc_set_vcc -bank 1 1.8
ldc_set_vcc -bank 3 1.2
ldc_set_vcc -bank 5 1.8

# External clock + IR TX pair
ldc_set_location -site {16} [get_ports ext_xo_i]
ldc_set_port -iobuf {TERMINATION=OFF IO_TYPE=LVCMOS18H} [get_ports ext_xo_i]
ldc_set_location -site {11} [get_ports ir_txa_o]
ldc_set_location -site {43} [get_ports ir_txb_o]
ldc_set_port -iobuf {IO_TYPE=LVDS DRIVE=NA SLEWRATE=NA} [get_ports ir_txa_o]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18 DRIVE=8 SLEWRATE=MED} [get_ports ir_txb_o]

# nRF SPI bridge + IRQ
ldc_set_location -site {58} [get_ports nrf_sclk_i]
ldc_set_location -site {60} [get_ports nrf_mosi_i]
ldc_set_location -site {19} [get_ports nrf_csn_i]
ldc_set_location -site {20} [get_ports nrf_miso_o]
ldc_set_location -site {E2} [get_ports nrf_irq_o]
ldc_set_port -iobuf {PULLMODE=NONE IO_TYPE=LVCMOS18} [get_ports nrf_sclk_i]
ldc_set_attribute {USE_PRIMARY=FALSE} [get_nets nrf_sclk_i_c]
ldc_set_port -iobuf {PULLMODE=NONE IO_TYPE=LVCMOS18} [get_ports nrf_mosi_i]
ldc_set_port -iobuf {PULLMODE=NONE IO_TYPE=LVCMOS18H} [get_ports nrf_csn_i]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18H} [get_ports nrf_miso_o]

# Regulator enable
ldc_set_location -site {42} [get_ports en_ldo_o]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports en_ldo_o]
# <<< AXON PERIPHERAL SDK FRAMEWORK CONSTRAINTS <<<

