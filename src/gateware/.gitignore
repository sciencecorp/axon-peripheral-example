# Build outputs (regenerated by axon-peripheral-sdk build)
build/

# Build-time generated SV (regenerated by `make` on every build)
src/git_hash.sv
src/version.sv

# Python
__pycache__/
*.pyc
*.pyo

# Cocotb sim artifacts
sim_build_*/
**/results.xml

# Radiant build artifacts (left in-tree by a Radiant build/promote run)
radiantc.log.*
radiantc.tcl.*
src/.recovery
src/impl_1/
src/promote.pfl
src/promote.xml
